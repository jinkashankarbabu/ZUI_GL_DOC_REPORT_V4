{
  "_version": "1.89.0",
  "sap.app": {
    "id": "com.zfi.gl.zuigldocreportv4",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.33.0",
      "toolsId": "e71530fb-5b36-401b-8ccd-d79cdd490612"
    },
    "dataSources": {
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zui_gl_doc_report_v4/srvd/sap/zui_gl_doc_report/0001/",
        "type": "OData",
        "settings": {
          "annotations": [
            "annotation"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "ZFIGLDocReport-display": {
          "semanticObject": "ZFIGLDocReport",
          "action": "display",
          "title": "{{ZFIGLDocReport-display.flpTitle}}",
          "subTitle": "{{ZFIGLDocReport-display.flpSubtitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.153.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {},
        "sap.f": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.zfi.gl.zuigldocreportv4.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "HeadersList",
          "target": [
            "HeadersList"
          ]
        },
        {
          "pattern": "Headers({key}):?query:",
          "name": "HeadersObjectPage",
          "target": [
            "HeadersList",
            "HeadersObjectPage"
          ]
        },
        {
          "pattern": "Headers({key})/_Items({key2}):?query:",
          "name": "ItemsObjectPage",
          "target": [
            "HeadersList",
            "HeadersObjectPage",
            "ItemsObjectPage"
          ]
        }
      ],
      "targets": {
        "HeadersList": {
          "type": "Component",
          "id": "HeadersList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Headers",
              "variantManagement": "Page",
              "navigation": {
                "Headers": {
                  "detail": {
                    "route": "HeadersObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "enableExport": true,
                    "personalization": true,
                    "quickVariantSelection": {
                      "paths": [
                        {
                          "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#table"
                        }
                      ],
                      "showCounts": true
                    },
                    "disableCopyToClipboard": false,
                    "enableMassEdit": false,
                    "popinLayout": "GridSmall",
                    "widthIncludingColumnHeader": true
                  },
                  "columns": {
                    "Fragment_01": {
                      "header": "AI Analysis",
                      "position": {
                        "anchor": "DataField::PostingDate",
                        "placement": "After"
                      },
                      "template": "com.zfi.gl.zuigldocreportv4.ext.fragment.Fragment_01",
                      "aiNotice": {
                        "contentFragmentName": "com.zfi.gl.zuigldocreportv4.ext.fragment.AI"
                      },
                      "availability": "Default",
                      "horizontalAlign": "Begin",
                      "importance": "Medium",
                      "width": "180px"
                    },
                    "DataField::PostingDate": {
                      "aiNotice": false
                    }
                  }
                }
              },
              "hideFilterBar": false,
              "defaultTemplateAnnotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#table",
              "initialLoad": "Enabled"
            }
          }
        },
        "HeadersObjectPage": {
          "type": "Component",
          "id": "HeadersObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Headers",
              "navigation": {
                "_Items": {
                  "detail": {
                    "route": "ItemsObjectPage"
                  }
                }
              },
              "content": {
                "header": {
                  "aiNotice": {
                    "contentFragmentName": "com.zfi.gl.zuigldocreportv4.ext.fragment.AI"
                  },
                  "anchorBarVisible": true
                }
              }
            }
          }
        },
        "ItemsObjectPage": {
          "type": "Component",
          "id": "ItemsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Headers/_Items"
            }
          }
        }
      }
    },
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {}
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    },
    "macros": {
      "table": {
        "defaultCreationMode": "InlineCreationRows",
        "defaultPopinLayout": "Block"
      }
    }
  }
}
